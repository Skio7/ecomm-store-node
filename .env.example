# ecomm-store-node local config. Copy to .env (ignored when NODE_ENV=production —
# production config comes from DeployKar env vars).

NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# MongoDB (DeployKar's connect_database sets MONGODB_URI). Shared with ecomm-orders-python.
MONGODB_URI=mongodb://127.0.0.1:27017/deploykar_shop

# Must be IDENTICAL on ecomm-store-node and ecomm-orders-python. ≥32 chars in production.
JWT_SECRET=dev-jwt-secret-not-for-production
INTERNAL_API_KEY=dev-internal-key-not-for-production

# Origin of ecomm-orders-python (no path). Used to send welcome / password-changed notifications.
ORDERS_SERVICE_URL=http://localhost:4002

# Demo data. The admin account is only created in production if this is set (≥10 chars).
SEED_DATA=true
# SEED_ADMIN_PASSWORD=

# Exposes GET /api/<module>/debug/echo (shows the path/headers the service received).
ENABLE_DEBUG_ENDPOINTS=true
